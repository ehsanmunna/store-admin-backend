{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "Frozen.API",
    "Audience": "Frozen.Clients",
    "ExpiryMinutes": 60
  },
  "SeedAdmin": {
    "Email": "admin@frozen.local",
    "Password": "",
    "FirstName": "Super",
    "LastName": "Admin"
  },
  "RabbitMq": {
    "Uri": "",
    "Exchange": "frozen.catalog",
    "OrdersExchange": "frozen.orders",
    "ExchangeType": "topic",
    "Durable": true
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:3000" ]
  },
  "AllowedHosts": "*"
}
